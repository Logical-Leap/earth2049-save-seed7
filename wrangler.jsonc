{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earth2049-coop",
  "main": "workers/coop-worker.js",
  "compatibility_date": "2026-07-08",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }
  ]
}
